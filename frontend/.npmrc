# Project policy: npm update and npx resolve only versions published at least
# 7 days ago (npm ci still installs the lockfile as it is).
min-release-age=7

# No package install scripts: npm ci runs in the CI jobs that compile and
# upload the release binaries and on the maintainer's machine, so a
# compromised package's install script would run there. The lockfile's only
# install script is fsevents (optional, macOS-only), which ships prebuilt.
ignore-scripts=true
